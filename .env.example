# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Ключ API kie.ai (https://kie.ai/api-key)
KIE_API_KEY=your_kie_key

# Telegram ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=123456789

# Текстовая модель (OpenAI-совместимый эндпоинт kie.ai)
TEXT_MODEL_PATH=/gemini-3-5-flash-openai/v1/chat/completions
TEXT_MODEL=gemini-3-5-flash

# Модель редактирования фото для дизайна интерьера
IMAGE_MODEL=google/nano-banana-edit
# Картинка ремонта по 3D-скану, если к скану нет фото
T2I_MODEL=google/nano-banana

# Путь к базе данных
DB_PATH=stroybot.db

# Сколько кредитов дарим новому пользователю
WELCOME_CREDITS=3

# Модель распознавания голосовых (kie.ai)
STT_MODEL=elevenlabs/speech-to-text

# Контакт поддержки для /paysupport (например, @your_username)
SUPPORT_CONTACT=

# Mini App: публичный HTTPS-адрес бота (например, https://stroybot.example.ru).
# Оставьте пустым, пока нет домена с HTTPS: бот будет работать без Mini App.
WEBAPP_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080
